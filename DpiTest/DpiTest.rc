#include <windows.h>
#include "resource.h"

IDI_TEST ICON "res\\test.ico"

IDD_PAGE DIALOGEX 0, 0, 220, 120
STYLE DS_SETFONT | WS_CHILD | WS_CAPTION
CAPTION "Page"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Some text on the page", -1, 7, 7, 200, 10
    EDITTEXT 1000, 7, 22, 200, 14
END

IDD_DIALOG DIALOGEX 0, 0, 200, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog DPI test"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 88, 58, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 143, 58, 50, 14
    PUSHBUTTON "Other", 1001, 7, 58, 50, 14
END
